generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum RolEmpleado {
  SUPER_ADMIN
  ADMIN_EMPRESA
  GERENTE
  CAJA
  MESERO
  COCINA
  BARRA
}

enum EstadoMesa {
  DISPONIBLE
  OCUPADA
  SUCIA
}

enum EstadoOrden {
  PENDIENTE
  EN_PREPARACION
  LISTA
  ENTREGADA
  CERRADA
  CANCELADA
  PAGADA
  POR_COBRAR
}

enum DestinoProducto {
  COCINA
  BARRA
}

// ==========================================
// MODELOS JERARQUÍA (SaaS)
// ==========================================

model Empresa {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  sucursales Sucursal[]
  empleados  Empleado[]
  categorias Categoria[]
  productos  Producto[]

  @@map("empresas")
}

model Sucursal {
  id        Int      @id @default(autoincrement())
  empresaId Int      @map("empresa_id")
  nombre    String   @db.VarChar(100)
  direccion String?  @db.VarChar(255)
  telefono  String?  @db.VarChar(20)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  empresa    Empresa            @relation(fields: [empresaId], references: [id])
  empleados  Empleado[]
  mesas      Mesa[]
  inventario SucursalProducto[]
  
  // ⬅️ NUEVO: Relación con Turnos
  turnos     Turno[]

  @@map("sucursales")
}

model Empleado {
  id         Int         @id @default(autoincrement())
  empresaId  Int?        @map("empresa_id")
  sucursalId Int?        @map("sucursal_id")
    
  nombre            String      @db.VarChar(100)
  email             String      @unique @db.VarChar(100)
  password          String      @db.VarChar(255)
  rol               RolEmpleado @default(MESERO)
    
  activo            Boolean  @default(true) 
  enVacaciones      Boolean  @default(false) @map("en_vacaciones")
  fechaContratacion DateTime @default(now()) @map("fecha_contratacion")

  empresa  Empresa?  @relation(fields: [empresaId], references: [id])
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id])
  ordenes  Orden[]
  
  // ⬅️ NUEVO: Relación con Turnos
  turnos   Turno[]
    
  @@index([empresaId])
  @@index([sucursalId])
  @@map("empleados")
}

// ==========================================
// MODELOS OPERATIVOS
// ==========================================

model Mesa {
  id            Int         @id @default(autoincrement())
  numero        String
  capacidad     Int
  tipo          String?
  estado        EstadoMesa  @default(DISPONIBLE)
  posX          Int?
  posY          Int?
  mesero        String?     // Nombre del mesero
  meseroId      Int?        // ID del mesero
  horaApertura  DateTime?   // ✅ NUEVO: Timestamp de cuándo se ocupó
  
  sucursalId    Int
  sucursal      Sucursal    @relation(fields: [sucursalId], references: [id])
  
  ordenes       Orden[]
  
  @@map("Mesa")
}



model Categoria {
  id        Int    @id @default(autoincrement())
  empresaId Int    @map("empresa_id")
  nombre    String @db.VarChar(100)
    
  descripcion String? @db.VarChar(255)
  iconoColor  String? @db.VarChar(50) 
  imagenUrl   String? @map("imagen_url") @db.Text 
    
  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  productos Producto[]

  @@unique([empresaId, nombre])
  @@map("categorias")
}

model Producto {
  id          Int             @id @default(autoincrement())
  empresaId   Int             @map("empresa_id")
  categoriaId Int?            @map("categoria_id")
    
  nombre           String          @db.VarChar(255)
  descripcion      String?         @db.Text
  precioBase       Decimal         @db.Decimal(10, 2) @map("precio_base")
  imagenUrl        String?         @db.VarChar(255) @map("imagen_url")
  destino          DestinoProducto @default(COCINA)
    
  configuracion Json?           @map("configuracion_json") 

  empresa        Empresa             @relation(fields: [empresaId], references: [id])
  categoria      Categoria?          @relation(fields: [categoriaId], references: [id])
  itemsOrden     ItemOrden[]
  disponibilidad SucursalProducto[]

  @@index([empresaId])
  @@map("productos")
}

model SucursalProducto {
  sucursalId Int     @map("sucursal_id")
  productoId Int     @map("producto_id")
  disponible Boolean @default(true)
  stock      Int?

  sucursal Sucursal @relation(fields: [sucursalId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@id([sucursalId, productoId])
  @@map("sucursal_productos")
}

model Orden {
  id          Int         @id @default(autoincrement())
  mesaId      Int?        @map("mesa_id")
  meseroId    Int?        @map("empleado_id")
  estado      EstadoOrden @default(PENDIENTE)
    
  comensales  Int      @default(1)
  total       Decimal? @db.Decimal(10, 2)
  notaGeneral String?  @db.Text
    
  creadaEn    DateTime  @default(now()) @map("creada_en")
  cerradaEn   DateTime? @map("cerrada_en")
  propina     Float?    @default(0)
  metodoPago  String?

  mesa   Mesa?      @relation(fields: [mesaId], references: [id])
  mesero Empleado?  @relation(fields: [meseroId], references: [id])
  items  ItemOrden[]
  pagos  Pago[]

  @@index([mesaId])
  @@map("ordenes")
}

model ItemOrden {
  id             Int         @id @default(autoincrement())
  ordenId        Int         @map("orden_id")
  productoId     Int         @map("producto_id")
  cantidad       Int
  precioUnitario Decimal     @db.Decimal(10, 2) @map("precio_unitario")
    
  opcionesElegidas Json?       @map("opciones_elegidas")
  estado           EstadoOrden @default(PENDIENTE) 
  
  // ✅ CAMBIO REALIZADO: Nuevo campo destino
  destino          String?     @db.VarChar(20) // "COCINA" o "BARRA"

  notas            String?     @db.Text

  orden    Orden    @relation(fields: [ordenId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("items_orden")
}

model Pago {
  id      Int      @id @default(autoincrement())
  ordenId Int      @map("orden_id")
  monto   Decimal  @db.Decimal(10, 2)
  metodo  String   @db.VarChar(50)
  fecha   DateTime @default(now())
    
  orden Orden @relation(fields: [ordenId], references: [id])

  @@map("pagos")
}

// ==========================================
// ⬅️ NUEVO MODELO PARA GESTIÓN DE TURNOS
// ==========================================
model Turno {
  id         Int      @id @default(autoincrement())
  empleadoId Int      @map("empleado_id")
  sucursalId Int      @map("sucursal_id")
  
  fecha      DateTime // El día del turno (YYYY-MM-DD)
  horaInicio String   @map("hora_inicio") @db.VarChar(10) // "09:00"
  horaFin    String   @map("hora_fin")    @db.VarChar(10) // "17:00"
  notas      String?  @db.Text

  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])

  @@index([empleadoId])
  @@index([sucursalId])
  @@map("turnos")
}